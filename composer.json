{
    "name": "mk-j/php_xlsxwriter",
    "description": "PHP Library to write XLSX files",
    "keywords": ["php", "library","xls", "xlsx", "excel"],
    "type": "library",
    "homepage": "https://github.com/mk-j/PHP_XLSXWriter",
    "license": "MIT",

    "autoload": {
        "classmap": ["xlsxwriter.class.php"]
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.5 || ^12.0"
    },
    "require": {
        "php": ">=5.4",
        "ext-zip": "*"
    },
    "suggest": {
        "ext-mbstring": "Multibyte-safe truncation of sheet names and long cell values"
    },
    "scripts": {
        "test": "phpunit"
    }
}
